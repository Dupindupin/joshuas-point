# Deployment identity. Search indexing is enabled only when this is explicitly production.
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=development

# Deployment-specific canonical origin used by metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Published Sanity content source.
NEXT_PUBLIC_SANITY_PROJECT_ID=8m6fb3x7
NEXT_PUBLIC_SANITY_DATASET=production

# Private operational records live in a separate Sanity project and must never target the public
# website project above. Keep all three values server-only; never prefix them with NEXT_PUBLIC_.
SANITY_OPERATIONS_PROJECT_ID=bx0jlvt3
SANITY_OPERATIONS_DATASET=operations
SANITY_OPERATIONS_TOKEN=replace_with_a_private_operations_write_token

# Server-only secret shared with the signed Sanity document webhook.
# Generate a unique value per deployment. Never prefix this variable with NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=replace_with_a_long_random_secret

# Temporary launch gate. When enabled, public routes show the branded Coming Soon page while
# approved reviewers can unlock the complete site at /coming-soon?access=1. Keep the bypass secret
# server-only and remove both values after launch.
COMING_SOON_MODE=disabled
COMING_SOON_BYPASS_SECRET=replace_with_a_long_random_review_secret

# Optional map provider adapter. MapLibre is the production default when this is omitted.
# Supported adapter names: google-maps, leaflet, maplibre.
NEXT_PUBLIC_MAP_PROVIDER=maplibre

# MapLibre GL JS uses the bundled Joshua's Point styles by default. Override these URLs only when
# moving the styles to an owner-controlled or self-hosted OpenMapTiles-compatible service.
NEXT_PUBLIC_MAPLIBRE_STYLE_URL_LIGHT=/maps/styles/joshuas-point-light.json
NEXT_PUBLIC_MAPLIBRE_STYLE_URL_DARK=/maps/styles/joshuas-point-dark.json

# Enquiry email delivery
# Supported now: resend. SMTP and other adapters can implement the same service contract later.
# Configure these values separately in each deployment environment. Never commit real values.
ENQUIRY_EMAIL_MODE=disabled
ENQUIRY_EMAIL_PROVIDER=resend
# Recommended: authenticate a dedicated transactional subdomain in Resend.
ENQUIRY_FROM_EMAIL="Joshua's Point <enquiries@updates.joshuaspoint.com>"
# Public, monitored Joshua's Point mailbox. Phone and WhatsApp are intentionally not configured.
ENQUIRY_TO_EMAIL=mail@joshuaspoint.com
ENQUIRY_REPLY_TO_EMAIL=mail@joshuaspoint.com
# Optional owner-controlled mailbox used to identify successful delivery tests in the private
# Owner Dashboard. The address itself is never returned to Studio or displayed.
ENQUIRY_OWNER_TEST_EMAIL=

# Required when ENQUIRY_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_a_real_key

# Coming Soon updates. Keep disabled until the confirmation flow, Resend Contacts permissions,
# Segment and Topic have been reviewed. Use a separate full-access key for Contacts management;
# the transactional sending key can remain domain-restricted sending-only.
SUBSCRIPTION_EMAIL_MODE=disabled
SUBSCRIPTION_FROM_EMAIL="Joshua's Point <updates@updates.joshuaspoint.com>"
SUBSCRIPTION_REPLY_TO_EMAIL=mail@joshuaspoint.com
SUBSCRIPTION_CONFIRMATION_SECRET=replace_with_a_separate_long_random_secret
RESEND_CONTACTS_API_KEY=re_replace_with_a_contacts_management_key
RESEND_UPDATES_SEGMENT_ID=replace_with_resend_segment_id
RESEND_UPDATES_TOPIC_ID=replace_with_resend_topic_id

# Privacy-conscious visitor analytics. Keep disabled until Plausible has been configured and the
# public privacy notice has been updated. The script URL must be the HTTPS value supplied by the
# Plausible dashboard. Analytics also requires NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=production.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=joshuaspoint.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Production error and sampled performance monitoring. Runtime monitoring remains off unless both
# the explicit public gate and a DSN are present. SENTRY_AUTH_TOKEN is a build-only secret used for
# source-map upload and must never be exposed through a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
