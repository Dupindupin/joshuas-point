# Private Next.js staging deployment: https://preview.joshuaspoint.com
NEXT_PUBLIC_DEPLOYMENT_ENVIRONMENT=staging
NEXT_PUBLIC_SITE_URL=https://preview.joshuaspoint.com

# Published content from the production Sanity dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=8m6fb3x7
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_OPERATIONS_PROJECT_ID=bx0jlvt3
SANITY_OPERATIONS_DATASET=operations
SANITY_OPERATIONS_TOKEN=replace_with_a_private_operations_write_token

# Server-only secret shared with the signed Sanity document webhook.
SANITY_REVALIDATE_SECRET=replace_with_a_long_random_staging_secret

# Provider-neutral MapLibre integration. No Mapbox token is required.
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAPLIBRE_STYLE_URL_LIGHT=/maps/styles/joshuas-point-light.json
NEXT_PUBLIC_MAPLIBRE_STYLE_URL_DARK=/maps/styles/joshuas-point-dark.json

# Email is deliberately disabled on staging until Resend and the sending domain are ready.
ENQUIRY_EMAIL_MODE=disabled

# Do not add RESEND_API_KEY, SMTP credentials, or production sender configuration to staging
# while delivery remains disabled.

# Analytics and monitoring remain isolated from production by default. A separate staging Sentry
# project may be configured later, but the production-only application gate will not initialize it.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=joshuaspoint.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
