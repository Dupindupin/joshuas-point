{
  "version": 8,
  "name": "Joshua's Point — Dark",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org/\" target=\"_blank\">OpenFreeMap</a> © <a href=\"https://openmaptiles.org/\" target=\"_blank\">OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#171d1c"}},
    {"id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "wood"], "paint": {"fill-color": "#26382f", "fill-opacity": 0.82}},
    {"id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "grass"], "paint": {"fill-color": "#303a31", "fill-opacity": 0.76}},
    {"id": "landuse-farmland", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["==", ["get", "class"], "farmland"], "paint": {"fill-color": "#39372e", "fill-opacity": 0.62}},
    {"id": "parks", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": {"fill-color": "#293b32", "fill-opacity": 0.82}},
    {"id": "sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "sand"], "paint": {"fill-color": "#584f3e"}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": {"fill-color": "#15343d"}},
    {"id": "waterways", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": {"line-color": "#2d5963", "line-opacity": 0.9, "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 2.5]}},
    {"id": "road-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track"], true, false], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#101514", "line-opacity": 0.8, "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1, 16, 5]}},
    {"id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track"], true, false], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#484b44", "line-opacity": 0.9, "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 16, 3.25]}},
    {"id": "major-roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#725f4d", "line-opacity": 0.94, "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.7, 16, 3.4]}},
    {"id": "boundaries", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["<=", ["get", "admin_level"], 4], "paint": {"line-color": "#8d867d", "line-dasharray": [2, 3], "line-opacity": 0.42, "line-width": 0.8}},
    {"id": "water-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "layout": {"text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Italic"], "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 13, 15]}, "paint": {"text-color": "#9ac1c6", "text-halo-color": "#15343d", "text-halo-width": 1.2}},
    {"id": "road-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 11, "layout": {"symbol-placement": "line", "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 10}, "paint": {"text-color": "#c6beb2", "text-halo-color": "#171d1c", "text-halo-width": 1.5}},
    {"id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "layout": {"text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 15], "text-letter-spacing": 0.03}, "paint": {"text-color": "#eee7de", "text-halo-color": "#171d1c", "text-halo-width": 1.5}}
  ]
}
