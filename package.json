{
  "name": "joshuas-point",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build",
    "start": "npm --prefix web run start",
    "dev": "npm --prefix web run dev",
    "lint": "npm --prefix web run lint",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "studio:deploy-graphql": "sanity graphql deploy",
    "studio:dev": "sanity dev",
    "studio:start": "sanity start",
    "operations:build": "npm --prefix operations-studio run build",
    "operations:dev": "npm --prefix operations-studio run dev"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.9.2",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
